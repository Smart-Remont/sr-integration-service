# Every variable the service reads. Only src/config.py and src/database/config.py read env.
# Bank and partner URLs/credentials live in the DB (integration_provider_tab /
# integration_credential_tab), not here.

# --- Runtime ---
# stage | prod — selects the integration_credential_tab row for the bank
APP_ENV=stage
APP_VERSION=0.1.0
# /scalar + /openapi.json. Keep false on production.
API_DOCS_ENABLED=true
# Comma-separated
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=900
# Seconds a stopping worker has to finish its requests. Keep below stop_grace_period in
# docker-compose.yaml. While it waits the service is down, so keep it short: BIG routes live here.
GUNICORN_GRACEFUL_TIMEOUT=50
GUNICORN_LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Per gunicorn worker: total connections = workers × max
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50

# --- BIG Integration Basic Auth (POST /api/big_integration/*) ---
INTEGRATION_HS_BI_USER=hs_bi
INTEGRATION_HS_BI_PASSWORD=

# --- Installment Basic Auth (/api/v1/installment/ff/*, except webhook) ---
INSTALLMENT_API_USER=
INSTALLMENT_API_PASSWORD=

# --- Factoring Basic Auth (/api/v1/factoring/ff/*). Empty → INSTALLMENT_API_* ---
FACTORING_API_USER=
FACTORING_API_PASSWORD=
# Bank prescoring_factoring Basic Auth (fallback when the provider config has none)
FACTORING_PRESCORING_USER=
FACTORING_PRESCORING_PASSWORD=

# --- CRM → integrations-sr signed context (X-Integration-Context JWT) ---
# Empty = not enforced. Same secret as INTEGRATION_CONTEXT_SECRET on CRM.
INTEGRATION_CONTEXT_SECRET=
INTEGRATION_CONTEXT_AUDIENCE=integrations-sr
INTEGRATION_CONTEXT_ISSUERS=sr-crm

# --- MyNCA (client signatures on factoring print forms, cession) ---
MYNCA_BASE_URL=https://nca.smartremont.kz/api
MYNCA_TOKEN=
# Same as myspace NCA_MASTER_KEY: decrypts company EDS keys in nca.company_key_store_tab
NCA_MASTER_KEY=
OFFICE_PUBLIC_URL=https://office.smartremont.kz
# Public URL of this service (MyNCA back_url, bank callbacks)
PUBLIC_BASE_URL=https://devintegration.smart-remont.kz

# --- File storage (MinIO) ---
# Public URL prefix for stored files: STORAGE_PUBLIC_URL + /documents/...
# Empty → OFFICE_PUBLIC_URL → https://office.smartremont.kz
STORAGE_PUBLIC_URL=
MINIO_ENDPOINT=https://s3.smartremont.kz
MINIO_BUCKET=smartremont
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
# Basic Auth for /api/v1/storage/*. Empty → INSTALLMENT_API_*
STORAGE_API_USER=
STORAGE_API_PASSWORD=

# --- Kaspi (/api/kaspi/*) ---
# nginx allows only Kaspi addresses on this route and sends this value in X-Kaspi-Proxy-Secret.
# Empty -> 503, wrong or missing header -> 403
KASPI_PROXY_SECRET=

# --- Client document signing (/api/client_sign/*): pages moved from PHP ClientSignController ---
# All empty by default: the step that needs a value answers 503. Keep the MyNCA address and the
# partner address empty on local runs and on devintegration, or a test becomes a real signing process.
# Its own variables and not MYNCA_BASE_URL, which has a production default.
CLIENT_SIGN_MYNCA_BASE_URL=
CLIENT_SIGN_MYNCA_TOKEN=
# Address clients and MyNCA see: return_url and back_url of a signing process
CLIENT_SIGN_PUBLIC_URL=
# Serves /dict/report, /dict/ds-download and /documents/ (PHP office, while it lives)
CLIENT_SIGN_OFFICE_URL=
# ROOM_CHANGE documents: <address>/client_request/<id>/ds/<id>/document/download/
CLIENT_SIGN_MYSPACE_API_URL=
# Signed documents without a MyNCA group: <address>/get_signed_file/<id>/<type>/SIGNED/
# The address includes the /partner path, for example https://partner.example/partner
CLIENT_SIGN_PARTNER_URL=
# Long random value. Signs the back_url given to MyNCA; a callback with a wrong key gets 403.
CLIENT_SIGN_CALLBACK_SECRET=

# --- Company signing crons (/api/auto_sign/*): moved from PHP IntegrationController ---
# All empty by default: the route that needs a value answers 503, and nothing is signed.
# Keep them empty on stands: with real values a call puts the company signature on real contracts.
# Basic Auth for the crontab wget lines. Empty -> 503
AUTO_SIGN_CRON_USER=
AUTO_SIGN_CRON_PASSWORD=
# Address with /api, PHP constants.mynca_url, https only. Its own variables and not MYNCA_BASE_URL,
# which has a production default. Either empty or http -> 503 on cron-auto-sign-operator and
# cron-auto-upload-sign-doc. cron-auto-sign-operator also needs APP_ENV=prod, otherwise 503
AUTO_SIGN_MYNCA_BASE_URL=
AUTO_SIGN_MYNCA_TOKEN=
# PHP constants.master_key, decrypts nca.company_key_store_tab. Empty -> 503 on cron-auto-sign-operator
AUTO_SIGN_MASTER_KEY=

# --- SMS Kcell (/api/sms/*): crons moved from PHP IntegrationController ---
# Basic Auth for the crontab wget lines. Empty -> 503
SMS_CRON_USER=
SMS_CRON_PASSWORD=
# Full address of the POST that sends a batch, without credentials: the login and password go in
# their own variables below. Any of the three empty -> 503 on sms-notify
KCELL_SEND_URL=
KCELL_SEND_USER=
KCELL_SEND_PASSWORD=
# Address of batch statuses without the batch id: GET <address>/<batch_id>.
# Another host and another password than sending. Empty -> 503 on sms-notify-status
KCELL_BATCH_STATUS_URL=
KCELL_BATCH_STATUS_USER=
KCELL_BATCH_STATUS_PASSWORD=

# --- KL recognition (/api/v1/kl_recognition/*): apartment sheets of BI Group ---
# Basic Auth for callers. Empty → 503
KL_RECOGNITION_API_USER=
KL_RECOGNITION_API_PASSWORD=
# Cursor account key for Composer (Cursor dashboard → Integrations → API Keys, user key)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Node.js ≥ 22.13 running the Cursor SDK helper (the Docker image has it)
KL_RECOGNITION_NODE_BIN=node
KL_RECOGNITION_AGENT_TIMEOUT=300
# Recognitions per gunicorn worker at once; the rest wait
KL_RECOGNITION_MAX_PARALLEL=4
# Public BI endpoint returning the KL PDF by flat GUID
BI_LOAD_SHEET_URL=https://apigw.bi.group/crm-document/api/placement/public/loadSheet
